# Copy this file to `.env.local` and fill in values from your Supabase project.
# Never commit `.env.local` or real credentials.

# Project Settings → API (or the Connect dialog)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys
# Use the publishable key. Older dashboards label this `anon` / `legacy anon`.
# This is a public client key, not the secret service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Project Settings → API Keys → `service_role`
# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket used for module photos (must match the migration).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=module-photos
