# Copy this file to `.env.local` and fill in values from your Supabase project.
# Never commit `.env.local` or real credentials.

# Project Settings → Data API (or the Connect dialog)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys → publishable key
# Older dashboards label this `anon` / `legacy anon`.
# This is a public client key. Do not put a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional and unused by this foundation. Do not commit this value.
# Server-only. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket used for module photos (must match the migration).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=module-photos
